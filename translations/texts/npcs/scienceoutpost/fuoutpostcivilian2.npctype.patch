  {
    "op": "replace",
    "path": "/scriptConfig/dialog/converse/fuizku/default/8",
    "raw": "There is no reality in which you are smarter than I.",
    "value": "在任何情况下，你都不可能比我更聪明。"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/converse/fuanodyne/default/0",
    "raw": "If I see Kevin before lunch, I am going to get Thorlokk to pummel him into pulp.",
    "value": "如果午饭前让我碰到凯文，我就让索洛克把他揍成肉泥。"
