  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/converse/fuizku/default/6",
    "raw": "I'd love to skin a ponex and stuff its rotting carcass. Taxidermy is a hobby of mine, and Ponexes are horrifying flesh-devouring monsters.",
